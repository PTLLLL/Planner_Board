NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/planner_agent
DIRECT_URL=postgresql://postgres:postgres@localhost:55432/planner_agent
# Vercel + Supabase production example (set these in Vercel, do not commit secrets):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL uses the Session pooler (5432) because Vercel cannot reach Supabase IPv6-only direct connections.
# DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&sslmode=require
# APP_BASE_URL=https://<your-project>.vercel.app
# SESSION_JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">
SESSION_JWT_SECRET=replace-with-a-32-byte-random-secret
SESSION_COOKIE_NAME=planner_session
SESSION_MAX_AGE_DAYS=7
REDIS_URL=
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=planner-agent-mock
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRY=1
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
EMBEDDED_PG_PORT=55432
EMBEDDED_PG_DATA_DIR=./data/postgres
